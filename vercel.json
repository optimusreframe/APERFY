{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/products/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?slug=:slug"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?path=/"
    },
    {
      "source": "/ask",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?path=/ask"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?path=/contact"
    },
    {
      "source": "/auth",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?path=/auth"
    },
    {
      "source": "/cart",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|pinterest|slackbot|discordbot|googlebot|bingbot|yandex|duckduckbot|applebot" } }],
      "destination": "/api/social-preview?path=/cart"
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://wa.me; script-src 'self' https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://xftxyvgplghnelawkhvl.supabase.co https://images.unsplash.com; media-src 'self' blob: https://xftxyvgplghnelawkhvl.supabase.co; connect-src 'self' https://xftxyvgplghnelawkhvl.supabase.co wss://xftxyvgplghnelawkhvl.supabase.co; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
